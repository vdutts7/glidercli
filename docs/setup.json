{
  "meta": {
    "project": "glidercli",
    "updated": "2026-09-17"
  },
  "architecture": {
    "flow": "glidercli -> bserve (localhost relay) -> Chromium extension -> chrome.debugger -> tab",
    "relay_port_default": 19988,
    "relay_port_environment": ["GLIDER_PORT", "RELAY_PORT"],
    "extension_relay_port": 19988,
    "custom_port_requires_matching_extension_build": true,
    "relay_host": "127.0.0.1"
  },
  "requirements": {
    "node": ">=18",
    "browser": "Chromium-based (Chrome, Arc, Edge, Brave, etc.); see README Browsers section",
    "os": "macOS (tested), Linux (untested), Windows (untested)"
  },
  "install": {
    "cli": "npm install -g glidercli",
    "extension": {
      "cws": "https://chromewebstore.google.com/detail/glider/njbidokkffhgpofcejgcfcgcinmeoalj",
      "source": "https://github.com/vdutts7/glider"
    }
  },
  "endpoints": {
    "http": {
      "/status": "GET - extension/targets/clients status",
      "/targets": "GET - connected tabs",
      "/cdp": "POST - forward CDP command"
    },
    "websocket": {
      "/extension": "Glider extension connects here; published Chrome Web Store build uses port 19988",
      "/cdp": "cli/clients connect here"
    }
  },
  "config_paths": {
    "glider_home": "$GLIDER_HOME (default: $HOME/.glider)",
    "domains": "$GLIDER_HOME/config/domains.json",
    "domains_template": "config/domains.template.json (shipped in package)",
    "warch_root": "<registry-base>/warch/<host>/ (glider.json, gotchas.json, bexplore/)",
    "registry_base": "AGREGISTRY if set, else GLIDER_HOME",
    "resolve": "glider resolve <url> --json",
    "browser": "$GLIDER_HOME/config/browser.json",
    "daemon_log": "$GLIDER_HOME/daemon.log"
  },
  "discovery": "glider --help"
}
