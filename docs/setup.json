{
  "meta": {
    "project": "glidercli",
    "updated": "2026-11-03"
  },
  "architecture": {
    "flow": "glidercli -> bserve (localhost relay) -> Chromium extension -> chrome.debugger -> tab",
    "relay_port_default": 19988,
    "relay_port_environment": ["GLIDER_PORT", "RELAY_PORT"],
    "extension_relay_port": 19988,
    "custom_port_requires_matching_extension_build": true,
    "relay_host": "127.0.0.1"
  },
  "requirements": {
    "node": ">=18",
    "browser": "Chromium-based (Chrome default; Edge, Brave, Opera, Vivaldi, Helium, Arc); see README Browsers section",
    "os": "macOS (tested), Linux (untested), Windows (untested)"
  },
  "install": {
    "cli": "npm install -g glidercli",
    "extension": {
      "cws": "https://chromewebstore.google.com/detail/glider/njbidokkffhgpofcejgcfcgcinmeoalj",
      "source": "https://github.com/vdutts7/glider"
    }
  },
  "endpoints": {
    "http": {
      "/status": "GET - extension/targets/clients status; catalog true when GET /catalog exists",
      "/targets": "GET - connected CDP sessions",
      "/catalog": "GET - chrome.tabs by window (incognito from chrome.windows/tabs), attached debugger-only, stale reaped sessions",
      "/cdp": "POST - forward CDP command"
    },
    "websocket": {
      "/extension": "Glider extension connects here; published Chrome Web Store build uses port 19988",
      "/cdp": "cli/clients connect here"
    }
  },
  "config_paths": {
    "glider_home": "$GLIDER (default: $HOME/.glider)",
    "domains": "$GLIDER/config/domains.json",
    "domains_template": "config/domains.template.json (shipped in package)",
    "warch_root": "$GLIDER/warch/<host>/ (glider.json, gotchas.json, bexplore/)",
    "registry_base": "$GLIDER",
    "resolve": "glider resolve <url> --json",
    "browser": "$GLIDER/config/browser.json",
    "daemon_log": "$GLIDER/daemon.log",
    "cookies_jar": "$GLIDER/cookies/<host>/header.txt",
    "cookies_index": "$GLIDER/cookies/domains.json",
    "cookie_jar_verb": "glider cookie-jar sync|read|list|add|rm|rebuild",
    "cookie_jar_extra_warch": "GLIDER_EXTRA_WARCH_ROOT (optional, path-separated) for rebuild scan"
  },
  "discovery": "glider --help"
}
