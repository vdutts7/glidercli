{
  "name": "glidercli",
  "version": "0.4.9",
  "description": "Browser automation CLI. Control a configured Chromium browser through an extension CDP relay, run YAML tasks, and execute bounded autonomous loops.",
  "bin": {
    "glider": "bin/glider.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:syntax": "node --check bin/glider.js && node --check lib/bserve.js",
    "test:regression": "node --test tests/browser-config.test.js tests/core.test.js tests/cli-regression.test.js tests/relay-integration.test.js",
    "test:integration": "node --test tests/relay-integration.test.js tests/daemon-lifecycle.test.js",
    "test:pack": "node --test tests/npm-tarball.test.js",
    "test:smoke": "node tests/live-browser.smoke.js",
    "test:live": "node tests/live-browser.smoke.js",
    "prepublishOnly": "npm run test:syntax && npm test"
  },
  "keywords": [
    "browser",
    "automation",
    "cdp",
    "chrome",
    "devtools",
    "websocket",
    "cli",
    "loop",
    "ralph-wiggum",
    "autonomous"
  ],
  "author": "vd7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vdutts7/glidercli.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "files": [
    "bin/",
    "lib/",
    "docs/",
    "config/",
    "README.md"
  ]
}
