#!/bin/bash
# Blocks commits if email not in allowed list (reads from repo.spine.json)

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CONFIG="$ROOT/repo.spine.json"
EMAIL=$(git config user.email)

if [[ -f "$CONFIG" ]] && command -v jq &>/dev/null; then
    ALLOWED=$(jq -r '.allowed_emails[]' "$CONFIG" 2>/dev/null)
else
    exit 0
fi

[[ -z "$ALLOWED" ]] && exit 0

echo "$ALLOWED" | grep -qx "$EMAIL" && exit 0

echo ""
echo "BLOCKED: $EMAIL not in repo.spine.json allowed_emails"
echo ""
exit 1
