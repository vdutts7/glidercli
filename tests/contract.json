{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "glidercli.tests.contract",
  "version": "0.1.0",
  "about": "Public test scoreboard for glidercli. Missing test = deferred OK. Wrong/broken test = forbidden. Live executor = tests/live-browser.smoke.js only.",
  "law": {
    "no_broken_tests": true,
    "missing_ok": true,
    "wrong_forbidden": true,
    "cursor_never_imports": true,
    "sole_live_runner": "tests/live-browser.smoke.js"
  },
  "planes": {
    "unit": {
      "cmd": "npm test",
      "crx": false
    },
    "live": {
      "cmd": "npm run test:live",
      "crx": true,
      "runner": "tests/live-browser.smoke.js"
    },
    "pack": {
      "cmd": "npm run test:pack",
      "crx": false
    }
  },
